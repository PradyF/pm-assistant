# Kaiten
KAITEN_URL=https://your-company.kaiten.ru
KAITEN_TOKEN=your_kaiten_api_token_here
KAITEN_SPACE_ID=000000
KAITEN_BOARD_ID=0000000

# Timeweb AI
TIMEWEB_CHAT_KEY=your_timeweb_jwt_key_here
TIMEWEB_CHAT_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/YOUR_AGENT_ID/v1/chat/completions

# Лимиты AI-советника
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_IP=5
AI_RATE_LIMIT_GLOBAL=30

# Лимиты чата
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_COOLDOWN=3
CHAT_RATE_LIMIT_PER_IP=30
CHAT_RATE_LIMIT_GLOBAL=200
